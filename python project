class Student():
    def __init__(self, id, first_name, last_name, email, major):
        self.id = id
        self.first_name = first_name
        self.last_name = last_name
        self.email = email
        self.major = major
    def student_information(self):
        print(f"The student with an id of {self.id}, email of {self.email} and majoring in {self.major} is {self.first_name} {self.last_name}")
 
