class Marks():
    def __init__(self, student_id, course_id, grade):
        self.student_id = student_id
        self.course_id = course_id
        self.grade = grade
   
    def display_info(self):
        print(f"The student with an id of {self.student_id} had an {self.grade} in a course with the id of {self.course_id}")
